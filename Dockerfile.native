# 1) Builder: GraalVM with Native Image and Maven Wrapper
FROM ghcr.io/graalvm/native-image-community:25 AS build

WORKDIR /workspace

COPY . .

# Make sure Maven wrapper is executable
RUN chmod +x mvnw

# Build native image using the "native" profile
# - uses GraalVM Native Build Tools plugin configured in pom.xml
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -e -Pnative -DskipTests package

# 2) Runtime: small Debian-based image for the native binary
FROM debian:12-slim AS runtime

# Create non-root user
RUN groupadd --system app && useradd --system --create-home --gid app app

WORKDIR /app

# Copy native binary from builder
COPY --from=build /workspace/target/bitaxe-exporter-native /app/bitaxe-exporter

EXPOSE 8080

# Environment variables (Spring relaxed binding)
# Override in docker-compose
ENV BITAXE_INSTANCES_0_ID=1 \
    BITAXE_INSTANCES_0_BASEURL=http://192.168.178.91 \
    BITAXE_INSTANCES_1_ID=2 \
    BITAXE_INSTANCES_1_BASEURL=http://192.168.178.92

USER app

ENTRYPOINT ["./bitaxe-exporter"]
