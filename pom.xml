<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.0</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>
  <groupId>me.area55</groupId>
  <artifactId>bitaxe-exporter</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>bitaxe-exporter</name>
  <description>bitaxe-exporter</description>
  <url/>
  <licenses>
    <license/>
  </licenses>
  <developers>
    <developer/>
  </developers>
  <scm>
    <connection/>
    <developerConnection/>
    <tag/>
    <url/>
  </scm>
  <properties>
    <java.version>25</java.version>
    <openapi.generator.version>7.17.0</openapi.generator.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>me.area55.bitaxeexporter.BitaxeExporterApplication</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi.generator.version}</version>
        <executions>
          <execution>
            <id>generate-bitaxe-models</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/bitaxe-api.yml</inputSpec>
              <generatorName>java</generatorName>
              <library>webclient</library>
              <apiPackage>me.area55.bitaxeexporter.bitaxe.api</apiPackage>
              <modelPackage>me.area55.bitaxeexporter.bitaxe.model</modelPackage>
              <invokerPackage>me.area55.bitaxeexporter.bitaxe.invoker</invokerPackage>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <generateApis>false</generateApis>
              <generateModels>true</generateModels>
              <generateSupportingFiles>false</generateSupportingFiles>
              <configOptions>
                <useJakartaEe>true</useJakartaEe>
                <dateLibrary>java8</dateLibrary>
                <serializableModel>true</serializableModel>
                <booleanGetterPrefix>is</booleanGetterPrefix>
              </configOptions>
              <additionalProperties>hideGenerationTimestamp=true</additionalProperties>
              <skipValidateSpec>false</skipValidateSpec>
              <generateModelTests>false</generateModelTests>
              <generateModelDocumentation>false</generateModelDocumentation>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-openapi-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/openapi/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <!-- use -DskipTests as mvn arg -->
      <properties>
        <skipTests>true</skipTests>
      </properties>

      <build>
        <plugins>
          <!-- Spring Boot parent already defines this plugin in pluginManagement,
               so we only need to reference it here -->
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <!-- Name of produced binary -->
              <imageName>${project.artifactId}-native</imageName>

              <buildArgs>
                <!-- musl + static build: requires native-image-community:25-muslib as builder -->
                <!-- If switching to non-muslib image, remove -static and -libc=musl. -->
                <buildArg>--static</buildArg>
                <buildArg>--libc=musl</buildArg>
                <!-- For Netty / Java 25 foreign memory cleanup -->
                <buildArg>-H:+SharedArenaSupport</buildArg>
                <!-- More helpful error output when something is missing -->
                <buildArg>--report-unsupported-elements-at-runtime</buildArg>
                <!-- Reduce reflection config noise -->
                <buildArg>--trace-class-initialization=me.area55.bitaxeexporter</buildArg>
              </buildArgs>
            </configuration>

            <executions>
              <!-- This binds native:compile-no-fork to the Maven lifecycle when -Pnative is active -->
              <execution>
                <id>build-native</id>
                <phase>package</phase>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
